{
  "manifest_version": 3,
  "name": "BrowserMCP Extended",
  "version": "2.0.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "permissions": [
    "alarms",
    "cookies",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": "/icon/48.png",
    "default_title": "BrowserMCP Extended",
    "default_popup": "popup/index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      }
    }
  },
  "background": {
    "service_worker": "background/background-loader.js"
  },
  "description": "Connect your browser to AI clients with local MCP automation, a compact control panel, and HTTP/WebSocket network inspection."
}
